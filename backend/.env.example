APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173

# Select exactly one real backend-only QuoteExtractor adapter per deployment.
# This active example uses GroqCloud's Free-plan-capable GPT-OSS model.
# To use OpenAI instead, set AI_PROVIDER=openai and an OpenAI model ID.
# GET /health remains available if these values are missing or invalid.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
